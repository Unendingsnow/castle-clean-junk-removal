# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real credentials.

# ---- Required ----------------------------------------------------------

# From @BotFather after /newbot. Looks like: 1234567890:AAF...
# Server-side only. Do NOT prefix with NEXT_PUBLIC_ — that would ship the
# token to every visitor's browser.
TELEGRAM_BOT_TOKEN=

# Where leads get delivered. A personal chat id is a positive number;
# a group id is negative (e.g. -1001234567890).
# See "Finding your chat id" in the README.
TELEGRAM_CHAT_ID=

# ---- Recommended -------------------------------------------------------

# Timezone used to stamp each lead. Without this the server's own clock is
# used, which is UTC on Vercel — every lead would show the wrong time.
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
LEAD_TIMEZONE=America/New_York

# ---- Optional ----------------------------------------------------------

# Forum topic to deliver leads into — the "not-contacted" inbox.
# Find the number by opening the topic in Telegram Web; it's the last
# segment of the URL. Leave unset to post into the group's main feed.
# If the topic is ever deleted, leads fall back to the main feed rather
# than failing.
TELEGRAM_TOPIC_ID=

# Public site URL. Drives canonical tags, the sitemap, robots.txt and the
# Open Graph card. Vercel's own host is used as a fallback, but SET THIS the
# moment a custom domain is attached — otherwise canonicals point at the
# .vercel.app host and tell Google that's the real site.
# NEXT_PUBLIC_SITE_URL=https://castlecleanjunk.com

# Google Search Console HTML-tag verification. Only needed if you verify by
# meta tag rather than DNS; the tag is omitted when this is unset.
# GOOGLE_SITE_VERIFICATION=
